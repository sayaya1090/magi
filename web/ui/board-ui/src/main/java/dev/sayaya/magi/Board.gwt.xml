<?xml version="1.0" encoding="UTF-8"?>
<!-- 모듈 이름은 화면 판의 id와 겹치면 안 된다: GWT 부트스트랩이 모듈 이름을 id로 단 iframe을
     문서에 넣기 때문이다(실측: #board가 둘 — 판 하나와 그 iframe 하나). 판의 id는 운영 콘솔의
     계약(console.css가 그 이름으로 입힌다)이라 바꿀 수 있는 쪽은 이름이 우리 것인 모듈이다. -->
<module rename-to="boardview">
    <inherits name="com.google.gwt.user.User"/>
    <inherits name="org.jboss.elemento.Core"/>
    <inherits name="dagger.Dagger"/>
    <inherits name="dev.sayaya.Ui"/>
    <inherits name="dev.sayaya.Rx"/>
    <inherits name="dev.sayaya.magi.ConsoleBridge"/>
    <inherits name="dev.sayaya.magi.UiComponents"/>
    <entry-point class="dev.sayaya.magi.client.Application"/>
    <source path="client"/>
</module>
