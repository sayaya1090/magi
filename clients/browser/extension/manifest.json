{
  "manifest_version": 3,
  "name": "Magi Browser",
  "version": "0.1.0",
  "description": "Explicitly grant browser tabs to a local Magi assistant.",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:8737/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Magi Browser"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "minimum_chrome_version": "114"
}