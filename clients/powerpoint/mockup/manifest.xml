<?xml version="1.0" encoding="UTF-8"?>
<!--
  목업 애드인의 매니페스트.

  두 가지를 일부러 그렇게 뒀다.

  1) 최상위 <Requirements> 에 PowerPointApi 를 **안 적는다.** 적으면 조건이 안 맞는 PowerPoint 에서
     애드인이 목록에서 아예 사라져 사용자가 *왜* 없는지 모른다(DESIGN.md §3.3). 확인은 런타임에
     isSetSupported 로 하고 못 돈다고 **말한다.**

  2) VersionOverrides 안에는 SharedRuntime 1.1 을 적는다. 작업창이 닫혀도 코드가 살아 있어야
     하기 때문이다(§5.7) — 이게 없으면 창을 한 번 닫은 사용자에게는 permission 물음이 아무
     데도 안 도착한다. 이 요구는 §3.3 의 1.8 바닥보다 낮아 새로 걸러내는 것이 없다(부록 A).

     ⚠ 다만 공짜는 아니다. VersionOverrides 안의 <Requirements> 는 못 맞추면 이 절 전체가
     무시돼 **리본 단추가 통째로 사라진다** — 1) 이 피하려던 그 침묵이 단추에서 다시 난다.
     사람을 새로 걸러내진 않아서(걸리는 빌드는 이미 1.8 미달) 그대로 두는 것이고, 근거는
     부록 A 에 적었다.

  ⚠ 이 파일은 **한 번도 PowerPoint 에 붙여 본 적이 없다.** 이 머신에 PowerPoint 가 없다.
-->
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
  xsi:type="TaskPaneApp">

  <Id>6d2a9f14-3c7b-4a51-9f0e-8b2d4c6a1e73</Id>
  <Version>0.1.0.0</Version>
  <ProviderName>magi</ProviderName>
  <DefaultLocale>ko-KR</DefaultLocale>
  <DisplayName DefaultValue="magi (목업)" />
  <Description DefaultValue="채팅창·인용·안내의 목업. 모델에는 아직 안 붙는다." />
  <IconUrl DefaultValue="https://localhost:3000/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://localhost:3000/assets/icon-80.png" />
  <SupportUrl DefaultValue="https://github.com/sayaya1090/magi" />

  <AppDomains>
    <AppDomain>https://localhost:3000</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Presentation" />
  </Hosts>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost:3000/taskpane.html" />
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Presentation">

        <Runtimes>
          <!-- 이 한 줄이 §5.7 의 전제다. 창을 닫아도 런타임이 안 죽는다. -->
          <Runtime resid="Taskpane.Url" lifetime="long" />
        </Runtimes>

        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title" />
            <Description resid="GetStarted.Description" />
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl" />
          </GetStarted>
          <FunctionFile resid="Taskpane.Url" />

          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="magi.group">
                <Label resid="Group.Label" />
                <Icon>
                  <bt:Image size="16" resid="Icon.16" />
                  <bt:Image size="32" resid="Icon.32" />
                  <bt:Image size="80" resid="Icon.80" />
                </Icon>
                <Control xsi:type="Button" id="magi.taskpane.button">
                  <Label resid="Button.Label" />
                  <Supertip>
                    <Title resid="Button.Label" />
                    <Description resid="Button.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16" />
                    <bt:Image size="32" resid="Icon.32" />
                    <bt:Image size="80" resid="Icon.80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>magi.taskpane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Requirements>
      <bt:Sets DefaultMinVersion="1.1">
        <bt:Set Name="SharedRuntime" MinVersion="1.1" />
      </bt:Sets>
    </Requirements>

    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16" DefaultValue="https://localhost:3000/assets/icon-16.png" />
        <bt:Image id="Icon.32" DefaultValue="https://localhost:3000/assets/icon-32.png" />
        <bt:Image id="Icon.80" DefaultValue="https://localhost:3000/assets/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://localhost:3000/taskpane.html" />
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://github.com/sayaya1090/magi" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="Group.Label" DefaultValue="magi" />
        <bt:String id="Button.Label" DefaultValue="magi 창" />
        <bt:String id="GetStarted.Title" DefaultValue="magi 목업이 설치됐습니다" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="Button.Tooltip" DefaultValue="채팅창을 엽니다. 도형을 잡고 「선택 인용」을 누르면 인용부호로 담깁니다." />
        <bt:String id="GetStarted.Description" DefaultValue="홈 탭의 magi 단추로 창을 엽니다." />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
