<idea-plugin>
    <id>dev.sayaya.magi.ide</id>
    <name>magi</name>
    <vendor email="codemate.team@gmail.com">sayaya</vendor>

    <description><![CDATA[
        Runs a magi companion for the open project: it starts the workspace's daemon or attaches to
        the one already there, shows the turn as it happens, and answers the prompts it raises.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <!--
        화면 글자는 **IDE 가 정한 언어**를 따른다(사용자 지시): 기본은 영어이고, 한국어
        언어팩이 깔린 IDE 는 `MagiBundle_ko` 를 본다. 액션의 text/description 은 여기 안 적고
        번들의 `action.<id>.text` / `.description` 에서 온다 — 두 벌로 적으면 갈라진다.
    -->
    <resource-bundle>messages.MagiBundle</resource-bundle>
    <!--
        답의 마크다운을 하단 판 안에서 IDE 엔진으로 그린다(머메이드 포함). **선택 의존이
        필요하다**: 컴파일 의존만 두고 이 줄을 빼 두었더니 런타임에 그 플러그인 클래스가 우리
        플러그인의 클래스로더에 없어 렌더가 조용히 부분집합으로 떨어졌다(샌드박스 실측 —
        사용자가 "렌더러가 있다면 샵이 출력될 리가 없는데"로 잡았다). 선택인 이유는 마크다운
        플러그인이 없는 IDE 도 있어서고, 그때는 가벼운 렌더가 그대로 선다.
    -->
    <depends optional="true" config-file="magi-markdown.xml">org.intellij.plugins.markdown</depends>
    <!-- 고친 파일의 편집 화면에 변경 막대를 세운다(SimpleLocalLineStatusTracker, vcs.impl).
         마크다운과 같은 사유로 선언한다 — 컴파일 의존만으로는 런타임 클래스로더에 안 보인다. -->
    <depends optional="true" config-file="magi-vcs.xml">com.intellij.modules.vcs</depends>
    <!-- 터미널 출력에도 「이 출력 물어보기」를 건다 — 스택트레이스는 Run 콘솔만큼이나
         터미널에 뜬다. **새 터미널 엔진**의 팝업만이다: 클래식 엔진은 팝업을 코드로 지어
         등록할 그룹이 없고, 그때 이 액션은 회색이 아니라 아예 안 보인다(정직한 미표시). -->
    <depends optional="true" config-file="magi-terminal.xml">org.jetbrains.plugins.terminal</depends>

    <!--
        Two windows, and the split is the layout the design doc settles in §5 "어디에 놓나".

        The browser console puts the conversation in the centre column with the facts beside it,
        because a browser has no editor to put there. An IDE does: the centre belongs to the file
        being edited, and taking it would break §5's first rule ("do not build what the IDE has")
        with the layout rather than with a feature. So the conversation goes where IntelliJ already
        puts text that scrolls — the bottom dock, beside Run and Terminal — and the facts pane
        takes the right, where a tool window is independent and the console's sticky side column
        comes for free.

        The left is not ours at all: the console's workspace pane is the Project view and the Git
        tool window.
    -->
    <extensions defaultExtensionNs="com.intellij">
        <!--
            `canCloseContents` 는 **기본이 false** 이고, 그때 content 의 `isCloseable = true` 는
            조용히 무시된다(SDK Tool Windows, "Closing Tabs"). 그래서 사람이 연 세션 탭이
            영영 안 닫혔고, 탭에 걸어 둔 Disposer 가 안 돌아 그 탭의 스트림이 창이 죽을
            때까지 살았다 — 새는 것은 화면이 아니라 소켓이었다(가이드라인 검토 G4).

            스트라이프 글자와 아이콘: id 를 안 덮으면 버튼에 `magi.plan` 이라는 **식별자**가
            그대로 뜬다. 글자는 `toolwindow.stripe.<id>` 키에서, 아이콘은 여기서 — 도구창
            아이콘은 IDE 가장자리에 서므로 회색 단색이다(Icons, Tool window).
        -->
        <toolWindow id="magi" anchor="bottom" canCloseContents="true"
                    icon="/icons/magiToolWindow.svg"
                    factoryClass="dev.sayaya.magi.ide.ui.MagiToolWindow"/>
        <!-- The right dock's tenant is the PLAN (user decision, 2026-08-29): the one fact worth
             standing room — a plan that scrolls away is a plan you have to go find. Fed from the
             transcript stream's todos.changed facts; no new door. -->
        <toolWindow id="magi.plan" anchor="right" icon="/icons/magiToolWindow.svg"
                    factoryClass="dev.sayaya.magi.ide.ui.PlanToolWindow"/>
        <!--
            No right-dock facts window any more (user decision, 2026-08-29): the always-on level
            lives on the status bar, and the detailed facts + fleet fold into Settings > Tools >
            magi, where opening the screen IS the re-read (Configurable.reset). A pane that mostly
            said "still attached" was paying rent in the dock for one glance a day.
        -->

        <!--
            The status bar is not a duplicate of the tool windows. Tool windows are LAZY: they are
            not created until somebody opens them, which was measured in a sandbox IDE — the plugin
            loaded and the facts window never connected to the daemon because nothing clicked it.
            With only the two windows, "the companion is working" and "nobody opened the panel"
            look the same.
        -->
        <!-- 자리는 **잡지 않는다**: `order="first"` 는 플랫폼 위젯 전부보다 우리를 앞에
             놓는데, 그건 서드파티가 가져갈 자리가 아니다(가이드라인 검토 G14). -->
        <statusBarWidgetFactory id="magi.status"
                                implementation="dev.sayaya.magi.ide.ui.MagiStatusBarFactory"/>

        <!--
            Grey-text completion at the caret, calling the same daemon method the browser console's
            /complete route calls. One switch, not two: magi's own [autocomplete] settings decide,
            and a disabled companion answers with an empty string.
        -->
        <inline.completion.provider
            implementation="dev.sayaya.magi.ide.ui.MagiInlineCompletion"/>

        <!--
            Settings > Tools > magi. What used to be slash commands in the terminal, split by
            docs/UI.ko.md §5: standing state edits here, one-shot verbs on the tool window's
            title bar, and anything without a daemon door drawn read-only with the reason.
            Values live in the daemon, never in a PersistentStateComponent (§5.1).
        -->
        <projectConfigurable parentId="tools" id="magi.settings" displayName="magi"
                             instance="dev.sayaya.magi.ide.ui.MagiConfigurable"/>

        <!-- Failure balloons for the in-place entry points (commit draft, console ask): a failure
             must never be written into the field it was meant to fill. -->
        <notificationGroup id="magi" displayType="BALLOON"/>

        <!-- 타이핑 중 훑어보기가 할 말이 있을 때만 서는 띠 — IDE 가 원래 이런 말을 세우는
             자리다. 할 말이 없으면 아무것도 안 선다(침묵이 이 기능의 절반). -->
        <editorNotificationProvider implementation="dev.sayaya.magi.ide.ui.LookBanner"/>
        <!-- 손을 멈추면 버퍼를 훑는 귀 — 프로젝트가 열릴 때 문서 멀티캐스터에 붙는다(이미
             열려 있던 파일도 들린다). 기본이 꺼짐이라 켜기 전까지 호출이 없다. -->
        <postStartupActivity implementation="dev.sayaya.magi.ide.ui.LookStartup"/>

        <!-- Alt+Enter: the neighbours' inline-prompt seat, in our shape — attach the selection
             as a reference and start the question in the composer; the hands and the diff stay
             with the companion and its approval prompt. -->
        <intentionAction>
            <language/>
            <className>dev.sayaya.magi.ide.ui.AskAboutCodeIntention</className>
            <category>magi</category>
        </intentionAction>
    </extensions>

    <actions>
        <!--
            Entry points where the work already lives (the neighbours' pattern, SURVEY §1):
            the commit box gets a draft button riding the SAME git-msg door the web console's
            commit card calls (the box text is NOT sent — that wire field is a one-shot rules
            override that would silently displace the house template), and Run-console output —
            where stack traces live — gets an ask action sending the selection as a fenced
            prompt. Terminal output rides the same action: its context menus are separate groups
            (Terminal.OutputContextMenu, Terminal.ReworkedTerminalContextMenu), found in the
            terminal plugin's own plugin.xml rather than guessed.
        -->
        <action id="magi.draftCommit" class="dev.sayaya.magi.ide.ui.DraftCommitAction">
            <add-to-group group-id="Vcs.MessageActionGroup" anchor="last"/>
        </action>
        <action id="magi.askConsole" class="dev.sayaya.magi.ide.ui.AskConsoleAction">
            <add-to-group group-id="ConsoleView.PopupMenu" anchor="last"/>
            <add-to-group group-id="ConsoleEditorPopupMenu" anchor="last"/>
            <!-- 터미널 그룹은 그 플러그인의 것이라 여기 두지 않는다(magi-terminal.xml) —
                 터미널을 끈 IDE 에서 「그룹 없음」 에러가 난다(리뷰 F9). -->
        </action>
        <!--
            In the editor's context menu rather than a toolbar button: it acts on the file you are
            looking at, and that is where the IDE puts things that act on the file you are looking
            at. No keyboard shortcut is claimed — every free chord in this IDE belongs to somebody's
            muscle memory, and a plugin taking one is a plugin picking a fight.
        -->
        <action id="magi.lookOver" class="dev.sayaya.magi.ide.ui.LookOverAction">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <!--
            Same place as look-over, and for the same reason: it acts on the line you are looking at.
            No shortcut claimed — every free chord belongs to somebody's muscle memory.
        -->
        <!--
            Attach as REFERENCE (path:lines), not as pasted text: the excerpt is rendered and
            persisted by the core at send time (docs/CLIENTS §2) — from DISK, which is why the
            action saves the document as it attaches; the buffer/disk gap was measured to persist
            the wrong text as "what the agent saw".
            One action, two menus: the editor attaches the selection, the project view the files.
        -->
        <action id="magi.attach" class="dev.sayaya.magi.ide.ui.AttachToChatAction">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
        <!--
            지금 훑어보기 — **메인 툴바 오른쪽**이다(사용자 교정: 처음엔 선택해야만 뜨는
            플로팅 막대에 뒀는데, 파일을 보다 부르는 단추가 글자를 먼저 선택해야 나타나는
            것은 앞뒤가 바뀐 자리였다). 오른쪽 끝은 IDE 가 어시스턴트류 아이콘을 두는 자리라
            늘 보이고, 지금 편집기가 없으면 스스로 숨는다. 우클릭 메뉴에도 남긴다 — 그쪽은
            파일을 보며 손이 이미 가 있는 자리다.
        -->
        <action id="magi.lookNow" class="dev.sayaya.magi.ide.ui.LookNowAction">
            <add-to-group group-id="MainToolbarRight" anchor="first"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action id="magi.wroteThis" class="dev.sayaya.magi.ide.ui.WroteThisAction">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>

    <projectListeners>
        <listener class="dev.sayaya.magi.ide.ui.OpenBufferListener"
                  topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    </projectListeners>
</idea-plugin>
