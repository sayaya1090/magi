<idea-plugin>
    <id>dev.sayaya.magi.ide</id>
    <name>magi</name>
    <vendor email="codemate.team@gmail.com">sayaya</vendor>

    <description><![CDATA[
        Runs a magi companion for the open project: it starts the workspace's daemon or attaches to
        the one already there, shows the turn as it happens, and answers the prompts it raises.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <!--
        Two windows, and the split is the layout the design doc settles in §5 "어디에 놓나".

        The browser console puts the conversation in the centre column with the facts beside it,
        because a browser has no editor to put there. An IDE does: the centre belongs to the file
        being edited, and taking it would break §5's first rule ("do not build what the IDE has")
        with the layout rather than with a feature. So the conversation goes where IntelliJ already
        puts text that scrolls — the bottom dock, beside Run and Terminal — and the facts pane
        takes the right, where a tool window is independent and the console's sticky side column
        comes for free.

        The left is not ours at all: the console's workspace pane is the Project view and the Git
        tool window.
    -->
    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="magi" anchor="bottom" factoryClass="dev.sayaya.magi.ide.ui.MagiToolWindow"/>
        <!--
            No right-dock facts window any more (user decision, 2026-08-29): the always-on level
            lives on the status bar, and the detailed facts + fleet fold into Settings > Tools >
            magi, where opening the screen IS the re-read (Configurable.reset). A pane that mostly
            said "still attached" was paying rent in the dock for one glance a day.
        -->

        <!--
            The status bar is not a duplicate of the tool windows. Tool windows are LAZY: they are
            not created until somebody opens them, which was measured in a sandbox IDE — the plugin
            loaded and the facts window never connected to the daemon because nothing clicked it.
            With only the two windows, "the companion is working" and "nobody opened the panel"
            look the same.
        -->
        <statusBarWidgetFactory id="magi.status" order="first"
                                implementation="dev.sayaya.magi.ide.ui.MagiStatusBarFactory"/>

        <!--
            Grey-text completion at the caret, calling the same daemon method the browser console's
            /complete route calls. One switch, not two: magi's own [autocomplete] settings decide,
            and a disabled companion answers with an empty string.
        -->
        <inline.completion.provider
            implementation="dev.sayaya.magi.ide.ui.MagiInlineCompletion"/>

        <!--
            Settings > Tools > magi. What used to be slash commands in the terminal, split by
            docs/UI.ko.md §5: standing state edits here, one-shot verbs on the tool window's
            title bar, and anything without a daemon door drawn read-only with the reason.
            Values live in the daemon, never in a PersistentStateComponent (§5.1).
        -->
        <projectConfigurable parentId="tools" id="magi.settings" displayName="magi"
                             instance="dev.sayaya.magi.ide.ui.MagiConfigurable"/>
    </extensions>

    <actions>
        <!--
            In the editor's context menu rather than a toolbar button: it acts on the file you are
            looking at, and that is where the IDE puts things that act on the file you are looking
            at. No keyboard shortcut is claimed — every free chord in this IDE belongs to somebody's
            muscle memory, and a plugin taking one is a plugin picking a fight.
        -->
        <action id="magi.lookOver" class="dev.sayaya.magi.ide.ui.LookOverAction"
                text="magi: 이 파일 훑어보기"
                description="열어 둔 버퍼를 컴패니언에게 보내 훑어보게 한다 (저장 안 한 내용 그대로)">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <!--
            Same place as look-over, and for the same reason: it acts on the line you are looking at.
            No shortcut claimed — every free chord belongs to somebody's muscle memory.
        -->
        <action id="magi.wroteThis" class="dev.sayaya.magi.ide.ui.WroteThisAction"
                text="magi: 이 줄을 쓴 턴"
                description="이 줄을 어느 턴이 썼고 그 턴은 무엇을 하라는 요청이었나 — 못 짚으면 못 짚는다고 말한다">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>

    <projectListeners>
        <listener class="dev.sayaya.magi.ide.ui.OpenBufferListener"
                  topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    </projectListeners>
</idea-plugin>
